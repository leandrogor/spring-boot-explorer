// REFERENCIA: Con Spring Data JPA, el repositorio se reduce a ESTO.
// Spring genera la implementación automáticamente en base al nombre del método.
// Equivale a un Repository genérico de TypeORM o un DbSet<Product> en EF Core.

package com.example.explorer.repository;

import com.example.explorer.domain.model.Product;
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.context.annotation.Profile;

@Profile("jpa")
public interface JpaProductRepository extends JpaRepository<Product, Long> {
    Optional<Product> findBySku(String sku);
    List<Product> findByCategoryId(Long categoryId);
    boolean existsBySku(String sku);
    // ¡Eso es todo! Spring Data genera findAll, findById, save, deleteById automáticamente.
}
